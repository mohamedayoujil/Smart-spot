<odoo>
    <record id="estate_property_action" model="ir.actions.act_window">
        <field name="name">Parking Spots</field>
        <field name="res_model">estate.property</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="estate_property_view_list" model="ir.ui.view">
        <field name="name">estate.property.list</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="zone"/>
                <field name="spot_type"/>
                <field name="hourly_rate"/>
                <field name="total_price"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="estate_property_view_form" model="ir.ui.view">
        <field name="name">estate.property.form</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <header>
                        <button name="action_reserve" type="object" string="Reserve" 
                                class="btn-primary" invisible="state != 'available'"/>
                        <button name="action_occupy" type="object" string="Mark Occupied" 
                                class="btn-warning" invisible="state != 'reserved'"/>
                        <button name="action_release" type="object" string="Release" 
                                class="btn-success" invisible="state not in ('reserved','occupied')"/>
                        <button name="action_maintenance" type="object" string="Maintenance" 
                                class="btn-danger" invisible="state == 'maintenance'"/>
                        <button name="action_available" type="object" string="Back to Available" 
                                class="btn-secondary" invisible="state != 'maintenance'"/>
                        
                        <field name="state" invisible="1"/>
                        
                        <widget name="web_ribbon" title="Available" 
                                bg_color="bg-success" invisible="state != 'available'"/>
                        <widget name="web_ribbon" title="Reserved" 
                                bg_color="bg-warning" invisible="state != 'reserved'"/>
                        <widget name="web_ribbon" title="Occupied" 
                                bg_color="bg-info" invisible="state != 'occupied'"/>
                        <widget name="web_ribbon" title="Under Maintenance" 
                                bg_color="bg-danger" invisible="state != 'maintenance'"/>
                    </header>
                    
                    <group>
                        <group>
                            <field name="name" string="Spot Number" 
                                   readonly="state in ('reserved','occupied')"/>
                            <field name="zone" string="Zone" 
                                   readonly="state in ('reserved','occupied')"/>
                            <field name="spot_type" string="Spot Type" 
                                   readonly="state in ('reserved','occupied')"/>
                            <field name="hourly_rate" string="Hourly Rate ($)" 
                                   readonly="state in ('reserved','occupied')"/>
                        </group>
                        <group>
                            <field name="state" widget="badge" string="Status" 
                                   readonly="1"/>
                        </group>
                    </group>

                    <group string="Reservation Details" invisible="state in ('occupied','maintenance')">
                        <group>
                            <field name="customer_name" string="Customer Name" 
                                   readonly="state in ('reserved')"/>
                            <field name="license_plate" string="License Plate" 
                                   readonly="state in ('reserved')"/>
                            <field name="reservation_start" string="Start Time" 
                                   readonly="state in ('reserved')"/>
                            <field name="reservation_end" string="End Time" 
                                   readonly="state in ('reserved')"/>
                        </group>
                        <group>
                            <field name="duration_hours" string="Duration (Hours)" readonly="1"/>
                            <field name="total_price" string="Total Price ($)" readonly="1" 
                                   class="text-success" style="font-size: 18px; font-weight: bold;"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>